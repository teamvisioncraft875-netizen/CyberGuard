# ==============================================================================
# CYBERGUARD — Backend API Gateway Environment Configuration (.env.example)
# ==============================================================================
# Duplicate this file to services/backend/.env for isolated backend execution.
# NEVER commit production credentials or populated .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY (MANDATORY)
# ------------------------------------------------------------------------------
# Secret key for signing and verifying JWT tokens (min 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Express HTTP listener port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Canonical Gateway base URL
CYBERGUARD_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/cyberguard

# Supabase API URL (Optional: auto-derived from SUPABASE_DB_URL if omitted)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Optional: for administrative storage/auth actions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Storage bucket name for evidence uploads (Default: cyberguard-media)
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Connection pool maximum clients (Default: 10)
DB_POOL_MAX=10

# Log SQL queries to console in development (Default: false)
DEBUG_SQL=false

# Enforce strict persistent database writes (Default: false)
STRICT_DB=false

# ------------------------------------------------------------------------------
# 3. AI/ML MICROSERVICE INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# URL of the upstream Python FastAPI detection engine
ML_SERVICE_URL=http://localhost:8000

# Request timeout in milliseconds for ML inference calls (Default: 2000)
ML_SERVICE_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 4. REDIS CACHING & BROKER (OPTIONAL)
# ------------------------------------------------------------------------------
# Redis connection URL for Copilot baseline caching and distributed rate limiting
# If omitted, system falls back gracefully to in-memory maps.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. AI SECURITY COPILOT (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API key for dynamic investigation reasoning
# If omitted, Copilot uses built-in deterministic heuristic fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Copilot LLM Request Timeout in milliseconds (Default: 10000)
COPILOT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 6. EXTERNAL THREAT INTELLIGENCE FEEDS (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional third-party API keys (graceful heuristic fallback when unset)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=

# ------------------------------------------------------------------------------
# 7. AUTOMATED NOTIFICATION SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# SendGrid (Preferred Provider)
SENDGRID_API_KEY=
SENDGRID_FROM=alerts@cyberguard.security

# SMTP Transport (Fallback Provider)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your_smtp_password_here
SMTP_FROM="CYBERGUARD Alert" <alerts@cyberguard.security>
SMTP_SECURE=false

# Fallback email recipient for escalated alerts
ALERT_ADMIN_EMAIL=admin@cyberguard.internal

# Web Dashboard base URL for action buttons in notification emails
DASHBOARD_URL=http://localhost:3000

# Public API Gateway base URL for webhook callbacks in notifications
API_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 8. DDOS DETECTION ENGINE THRESHOLDS (OPTIONAL)
# ------------------------------------------------------------------------------
DDOS_REQUEST_SPIKE_THRESHOLD=500
DDOS_POST_FLOOD_THRESHOLD=100
DDOS_LOGIN_ABUSE_THRESHOLD=10
DDOS_IP_FLOOD_THRESHOLD=20
DDOS_DISTRIBUTED_IP_THRESHOLD=20
DDOS_DISTRIBUTED_REQ_THRESHOLD=400

# ------------------------------------------------------------------------------
# 9. ADVANCED & TESTING OVERRIDES (OPTIONAL)
# ------------------------------------------------------------------------------
# Static IP override for firewall target resolution
# CYBERGUARD_BACKEND_IP=198.51.100.77

# Set to true to bypass Express rate limiting during automated test suites
# SKIP_RATE_LIMIT=false
