# ==============================================================================
# CYBERGUARD — Python AI/ML Microservice Environment Configuration (.env.example)
# ==============================================================================
# Duplicate this file to services/ml-service/.env before launching FastAPI.
# ==============================================================================

# Dedicated HTTP listener port for FastAPI detection engine (Default: 8000)
# Use ML_PORT to ensure clean separation from Node.js backend gateway (PORT=5000).
ML_PORT=8000

# Optional general port override (Automatically avoids colliding if set to 5000)
PORT=8000

# ------------------------------------------------------------------------------
# UPSTREAM LLM PHISHING CLASSIFIER (OPTIONAL)
# ------------------------------------------------------------------------------
# If keys are omitted, the service runs purely on local supervised scikit-learn
# models and heuristic rule engines without external API calls.

# OpenAI API Key (Preferred upstream classifier)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (Fast alternative / fallback upstream classifier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
