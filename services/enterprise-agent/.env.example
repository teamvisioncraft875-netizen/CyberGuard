# Central API Gateway URL
CYBERGUARD_BACKEND_URL=http://localhost:3000

# One-time enrollment token issued by organization administrator
ENROLLMENT_TOKEN=enroll_your_token_here

# Optional agent identifier / hostname override (defaults to socket.gethostname())
AGENT_NAME=laptop-john-dev

# Optional Intervals in seconds (default: 60)
HEARTBEAT_INTERVAL=60
TELEMETRY_INTERVAL=60
COMMAND_POLL_INTERVAL=60

# Optional custom path for non-secret identity credentials file
# AGENT_CREDS_PATH=C:\Users\username\.cyberguard\agent_creds.json
