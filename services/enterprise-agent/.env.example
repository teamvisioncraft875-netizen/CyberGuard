# ==============================================================================
# CYBERGUARD — Enterprise Endpoint Agent Environment Configuration (.env.example)
# ==============================================================================
# Duplicate this file to services/enterprise-agent/.env before starting the agent.
# ==============================================================================

# Central API Gateway URL (Target Express Gateway on Port 5000)
CYBERGUARD_BACKEND_URL=http://localhost:5000

# One-time enrollment token issued by organization administrator (Required for first run)
ENROLLMENT_TOKEN=enroll_your_token_here

# Optional agent identifier / hostname override (Defaults to socket.gethostname())
AGENT_NAME=endpoint-workstation-01

# Agent release version string reported in telemetry
AGENT_VERSION=1.0.0

# Intervals in seconds (Defaults: 60)
HEARTBEAT_INTERVAL=60
TELEMETRY_INTERVAL=60
COMMAND_POLL_INTERVAL=60

# Optional custom path for non-secret identity credentials file
# Defaults to ~/.cyberguard/agent_creds.json
# AGENT_CREDS_PATH=C:\Users\username\.cyberguard\agent_creds.json

# Optional in-memory credential secret override
# AGENT_CREDENTIAL_SECRET=your_agent_secret_here

# Optional direct telemetry API bearer token override
# TELEMETRY_API_KEY=your_telemetry_key_here
