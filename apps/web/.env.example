# ==============================================================================
# CYBERGUARD — Web Dashboard Client Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to apps/web/.env in development.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ==============================================================================

# API Gateway Base URL (Includes /api/v1 version prefix)
# Defaults to http://localhost:5000/api/v1 if omitted
VITE_API_URL=http://localhost:5000/api/v1

# Real-time WebSocket Gateway URL (Socket.io v4)
# Defaults to http://localhost:5000 (or derived from VITE_API_URL) if omitted
VITE_WS_URL=http://localhost:5000
