# CYBERGUARD Environment Variables Example
# Duplicate this file to .env in local environments. Never commit .env to version control.

# PostgreSQL / Supabase Database
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/cyberguard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Backend Service Configuration
PORT=5000
NODE_ENV=development

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your_fcm_server_key_here

# AI/ML Microservice Integration
ML_SERVICE_URL=http://localhost:8000
