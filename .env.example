# ==============================================================================
# CYBERGUARD — Monorepo Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root directory for unified local development.
# NEVER commit production credentials or populated .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE GATEWAY & AUTHENTICATION (MANDATORY)
# ------------------------------------------------------------------------------
# JWT Secret for signing and validating session and API tokens (min 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Node.js API Gateway Listen Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Canonical Gateway URL used for self-referencing and service discovery
CYBERGUARD_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MANDATORY)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler or direct PostgreSQL)
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/cyberguard

# Supabase API Endpoint (Optional: automatically extracted from DB URL if omitted)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Optional: for elevated admin and storage operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Storage Bucket for threat media and report attachments
SUPABASE_STORAGE_BUCKET=cyberguard-media

# Connection Pool Size Limit (Optional, default: 10)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. AI/ML MICROSERVICE INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Target URL of the Python FastAPI detection engine
ML_SERVICE_URL=http://localhost:8000

# Dedicated port for the ML service to prevent port collision with gateway
ML_PORT=8000

# HTTP client timeout in milliseconds for ML inference requests
ML_SERVICE_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 4. REDIS CACHING & BROKER (OPTIONAL)
# ------------------------------------------------------------------------------
# Redis connection URL for Copilot baseline caching and distributed rate limiting
# If omitted or unavailable, all services fall back seamlessly to in-memory caches.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. AI SECURITY COPILOT (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API Key for LLM-powered incident explanations and reasoning
# If omitted, Copilot automatically uses deterministic local synthesis fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Copilot LLM Request Timeout in milliseconds (Default: 10000)
COPILOT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 6. EXTERNAL THREAT INTELLIGENCE FEEDS (OPTIONAL)
# ------------------------------------------------------------------------------
# Third-party reputation lookups with circuit breakers and heuristic fallback
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=

# ------------------------------------------------------------------------------
# 7. AUTOMATED NOTIFICATION SERVICE (OPTIONAL)
# ------------------------------------------------------------------------------
# Preferred Email Provider: SendGrid (activated when SENDGRID_API_KEY is present)
SENDGRID_API_KEY=
SENDGRID_FROM=alerts@cyberguard.security

# Fallback Email Provider: SMTP (Nodemailer)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your_smtp_password_here
SMTP_FROM="CYBERGUARD Alert" <alerts@cyberguard.security>
SMTP_SECURE=false

# Default recipient for escalated security notifications if no admin user is resolved
ALERT_ADMIN_EMAIL=admin@cyberguard.internal

# Frontend Command Dashboard URL included in notification links
DASHBOARD_URL=http://localhost:3000