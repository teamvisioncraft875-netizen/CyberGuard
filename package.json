{
  "name": "cyberguard",
  "version": "0.1.0",
  "private": true,
  "description": "CYBERGUARD - AI-Powered Scam, Fraud & Cybercrime Defense Ecosystem",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "services/backend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run dev --workspace=services/backend",
    "dev:ml": "uvicorn app.main:app --app-dir services/ml-service --host 127.0.0.1 --port 8000 --reload",
    "dev:mobile": "npm start --workspace=apps/mobile",
    "dev:mobile:tunnel": "npm run tunnel --workspace=apps/mobile",
    "dev:mobile:web": "npm run web --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "start:backend": "npm start --workspace=services/backend",
    "test:mobile": "npm test --workspace=apps/mobile"
  },
  "keywords": [
    "cybersecurity",
    "anti-phishing",
    "fraud-detection",
    "ai-defense",
    "react",
    "react-native",
    "express",
    "fastapi"
  ],
  "author": "CYBERGUARD Team",
  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "react-dom": "18.2.0",
    "react-native-web": "~0.19.10"
  }
}
