  "cards": [
    {
      "dot": "cyan",
      "title": "Presentation & Sensors",
      "items": [
        "React Web Dashboard (apps/web) provides full SOC command, incident review, and metrics triage",
        "React Native Mobile App (apps/mobile) powers Guardian link pairing and push alerts",
        "Guard App Sensor (services/guard-app) streams host and login telemetry"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gateway & Protection",
      "items": [
        "Express API Gateway handles request termination, routing, and CORS policy",
        "Rate limiters enforce 5/15m (auth), 100/15m (check), and 300/15m (general) thresholds",
        "Auth & roleCheck middlewares enforce JWT verification and multi-tenant scoping"
      ]
    },
    {
      "dot": "rose",
      "title": "AI/ML Detection Stack",
      "items": [
        "FastAPI service executes parallel inference across message, URL, media, and login engines",
        "Login anomaly engine pairs Isolation Forest model with Cowrie honeypot behavioral baselines",
        "External APIs (Safe Browsing, VirusTotal, AbuseIPDB) enrich threat confidence scores"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & Real-Time",
      "items": [
        "Atomic transaction inserts across incidents, signals, actions, and MITRE mapping tables",
        "Row Level Security (RLS) ensures strict tenant and guardian scoping at the database layer",
        "Socket.io broadcasts instant notifications to user, org, and guardian rooms"
      ]
    }
  ]
}
