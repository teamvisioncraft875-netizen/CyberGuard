  "cards": [
    {
      "dot": "cyan",
      "title": "Client & Sensor Layer",
      "items": [
        "React Web Command Center (apps/web) provides SOC management, Attack Surface triage, DDoS analysis, and Incident response",
        "React Native Mobile App (apps/mobile) powers Guardian mode pairing, read-aloud TTS, and real-time push alerts",
        "Guard App Sensor & Enterprise Agent Fleet stream endpoint telemetry, listening ports, and heartbeats"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gateway, Security & Auth",
      "items": [
        "Express API Gateway handles route termination, role-based access control, and tenant isolation",
        "Adaptive rate limiters guard authentication and AI/ML inspection endpoints against abuse",
        "Socket.io Broadcaster powers sub-second live telemetry feeds across tenant and guardian channels"
      ]
    },
    {
      "dot": "rose",
      "title": "11 Production ML Detection Engines",
      "items": [
        "FastAPI service coordinates parallel inference across 11 registered threat detection engines",
        "Phishing NLP (Calibrated LinearSVC), URL Threat (HistGradientBoosting), and Anomaly Isolation Forest",
        "2D FFT frequency spectrum deepfake vision, ASVspoof voice cloning, BETH EDR process-tree, and EMBER malware analysis"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence, Evidence & Real-Time",
      "items": [
        "Supabase PostgreSQL with multi-tenant Row Level Security (RLS) ensures complete cryptographic tenant separation",
        "Atomic 4-table transaction inserts preserve synchronized incident, signal, action, and MITRE records",
        "Encrypted Supabase storage buckets store deepfake audio/video forensic evidence with signed URLs"
      ]
    },
    {
      "dot": "amber",
      "title": "Automated SOAR & Host Firewall Response",
      "items": [
        "SOAR Playbook Engine executes automated containment playbooks for credential stuffing and C2 egress",
        "Host Firewall Rule Manager controls ingress/egress policies with human-in-the-loop approval gating",
        "Execution Service enforces session revocation, IP quarantines, and logs an immutable audit trail"
      ]
    }
  ]
}